# codebox configuration — copy to `codebox.env` and edit.
# `codebox.env` is git-ignored; this example file is safe to commit.

# Where the box lives: `docker` (a container on this machine, the default) or `gcp` (a
# cloud VM behind an IAP tunnel). `--provider <name>` on the command line overrides this
# for one invocation. Everything under "gcp provider" below is ignored unless this is gcp.
CODEBOX_PROVIDER=""        # default: docker

# --- gcp provider (CODEBOX_PROVIDER="gcp") --------------------------------
# GCP project id (required). If left empty, the active `gcloud config` project is used.
CODEBOX_PROJECT=""

# Compute zone.
CODEBOX_ZONE="us-central1-a"

# Instance name.
CODEBOX_INSTANCE="codebox"

# Machine type: 4 vCPU / 16 GB. Bump for heavier workloads (e.g. e2-standard-8).
CODEBOX_MACHINE_TYPE="e2-standard-4"

# Boot disk size in GB.
CODEBOX_DISK_SIZE="50"

# OS image.
CODEBOX_IMAGE_FAMILY="debian-12"
CODEBOX_IMAGE_PROJECT="debian-cloud"

# Editor ports. LOCAL is on your laptop; REMOTE is what code-server binds to (loopback) on the VM.
CODEBOX_LOCAL_PORT="8080"
CODEBOX_REMOTE_PORT="8080"

# Extra ports to forward alongside the editor when you run `codebox connect`, as a
# comma-separated list (e.g. "8000,5173"). Each is bound to the SAME port number locally
# and on the VM, so a dev server on the box is reachable at the same localhost:<port>.
# Leave empty for none.
CODEBOX_ADDITIONAL_PORTS=""

# Auto-stop the VM after this many idle minutes. Set to 0 to disable idle shutdown.
CODEBOX_IDLE_TIMEOUT_MIN="30"

# Git repo to clone into the VM's home directory on create/bootstrap. Its root becomes the
# folder code-server opens by default. https and ssh URIs are both accepted and the `.git`
# suffix is optional, e.g. "https://github.com/owner/repo" or "git@github.com:owner/repo.git".
# ssh URIs (and private https repos) need credentials on the VM — see README.
# Leave empty to skip cloning.
CODEBOX_REPO=""

# --- GitHub access for the agent -----------------------------------------------------
# Lets Claude Code on the box clone a private repo, push branches, and open PRs.
# Use an https CODEBOX_REPO above so one credential covers git and the API.
# Pick ONE of the two options below (setting both is an error). See README for setup.

# Option A (recommended): a GitHub App. The agent gets its own `name[bot]` identity in
# git history and on PRs, costs no org seat, and every token it uses expires in an hour.
CODEBOX_GITHUB_APP_ID=""
CODEBOX_GITHUB_APP_INSTALLATION_ID=""
# Path on THIS laptop to the app's private key (.pem). It is copied to the VM, mode 600,
# and never committed — keep the original in your password manager.
CODEBOX_GITHUB_APP_KEY=""
# The bot's login and numeric user id are looked up from the API during bootstrap. Set
# these only to override the lookup (or if the box can't reach api.github.com).
CODEBOX_GITHUB_BOT_NAME=""
CODEBOX_GITHUB_BOT_USER_ID=""

# Repositories the agent may WRITE to, comma-separated owner/name. Everything else the app
# can see is minted read-only, so one app installed org-wide can give the agent push access
# to its own project and read access to the rest. Leave empty to keep tokens as broad as the
# installation. GitHub enforces the narrowing; see README, "Scoping what the agent can write".
CODEBOX_GITHUB_WRITE_REPOS=""

# Run the agent as its own unprivileged unix user inside the box (recommended when you set
# CODEBOX_GITHUB_WRITE_REPOS above). code-server, Claude Code and every editor terminal run
# as this user; the GitHub App key moves to a third account it cannot read, so the write-repo
# policy stops being self-imposed. You stay admin over 'codebox ssh'. Empty = one uid for
# everything, as before. See README, "Keeping the key away from the agent".
CODEBOX_AGENT_USER=""      # e.g. "agent"
# The uid that account is created with. Pinned so it survives rebuilding the box, which
# matters when a directory is shared with the host: uid numbers are the only thing that
# crosses a bind mount, so a uid that moved would no longer match the files already there.
CODEBOX_AGENT_UID=""       # default: 2000 on the docker provider, useradd's pick on gcp

# --- the agent's Claude Code credential and tool policy -------------------
# Path on THIS laptop to a token from `claude setup-token` (browser flow, one year, bills to
# your subscription — not an API key). Copied into the box and exported as
# CLAUDE_CODE_OAUTH_TOKEN, so boxes come up already authenticated. It can only make model
# requests: it cannot reach claude.ai connectors, which is deliberate — a connector whose
# scopes you cannot narrow is better absent than denied. Leave empty to run `claude` in the
# box once and log in there.
CODEBOX_CLAUDE_TOKEN_FILE=""

# Path on THIS laptop to a passphrase-less private ssh key, copied into the box as
# ~/.ssh/id_codebox with github.com's host keys pinned. Use a read-only DEPLOY KEY on the
# one repo the box needs to reach over ssh — per-repo and read-only, so it cannot write and
# cannot bypass CODEBOX_GITHUB_WRITE_REPOS. A personal ssh key here would do both.
# The case this exists for: Claude Code's background marketplace refresh disables git
# credential helpers, so a private plugin/skill marketplace has to be an ssh remote to stay
# in sync. Everything else should keep using https.
CODEBOX_SSH_KEY_FILE=""

# VS Code extensions to install into the box's code-server, comma-separated. Ids resolve
# against Open VSX (what code-server uses), not Microsoft's marketplace, so a
# Microsoft-only extension will not be found by id. A failure is a warning, not a failed
# bootstrap, and re-running is a no-op.
CODEBOX_CODE_EXTENSIONS=""       # e.g. "redhat.vscode-yaml, vscodevim.vim"

# Plugin marketplaces and plugins to set up in every box, comma-separated. Marketplaces are
# added first, then plugins as plugin@marketplace. Both are idempotent, so re-running
# bootstrap changes nothing, and both are additive — removing an entry here does not remove
# it from a box that already has it. An ssh source needs CODEBOX_SSH_KEY_FILE above.
CODEBOX_CLAUDE_MARKETPLACES=""   # e.g. "git@github.com:you/your-skills.git"
CODEBOX_CLAUDE_PLUGINS=""        # e.g. "your-plugin@your-skills"

# Permission policy written into the box's ~/.claude/settings.json. These survive
# --dangerously-skip-permissions: Claude Code evaluates deny rules in every mode, so this is
# how a box runs with no approval prompts and still cannot call a destructive tool.
# Values are shell-sourced, so quote them — deny patterns contain parens.
CODEBOX_AGENT_PERMISSION_MODE=""   # default|acceptEdits|plan|auto|dontAsk|bypassPermissions
CODEBOX_AGENT_DENY_TOOLS=""        # e.g. "mcp__claude_ai_Gmail__delete_email, Bash(rm -rf /*)"
# Only meaningful with dontAsk, which denies everything not listed here (fail-closed).
CODEBOX_AGENT_ALLOW_TOOLS=""

# Option B (quick): a fine-grained personal access token (Contents + Pull requests: R/W,
# scoped to the one repo). Give a *path* to a file holding the token — never paste the
# token here, this file is plaintext. Push and PRs work immediately, but they act as you.
CODEBOX_GITHUB_TOKEN_FILE=""

# Git identity for commits Claude Code makes on the box (author + committer). Defaults to
# the app's bot in Option A, and to an unlinked "codebox-agent" in Option B. Commits you
# make yourself in a terminal keep the identity in the VM's own ~/.gitconfig.
CODEBOX_GIT_AGENT_NAME=""
CODEBOX_GIT_AGENT_EMAIL=""

# --- docker provider (the default) ----------------------------------------
# Only used when the box is a local container. CODEBOX_PROJECT/ZONE and the other GCP
# settings above are ignored in that mode, and idle auto-suspend is always off: a local
# container costs nothing to leave running, so stop it yourself with 'codebox stop'.
# CODEBOX_INSTANCE names the container, same as it names the VM on GCP.
CODEBOX_DOCKER_IMAGE=""    # default: codebox:local — image tag built by 'create'
CODEBOX_DOCKER_USER=""     # default: coder — login user inside the container
# Host interface the editor (and CODEBOX_ADDITIONAL_PORTS) are published on. Loopback by
# default, so the box is reachable from this machine only. Change deliberately.
CODEBOX_DOCKER_BIND=""     # default: 127.0.0.1

# A directory shared between you and the agent, and the recommended way to work locally.
# codebox creates it, bind-mounts it as the box's project folder, and gives it to the agent
# — you keep read/write on everything in it (including files the agent creates) through a
# POSIX ACL, so no group membership or umask fiddling on your side. Set this and
# CODEBOX_REPO is not cloned.
#
#   CODEBOX_DOCKER_SHARED_DIR="~/codebox-work"  ->  /home/agent/codebox-work in the box
#
# Works with CODEBOX_AGENT_USER, which is the point of it. Needs a filesystem with POSIX
# ACLs — ext4, xfs and btrfs are fine; exFAT, FAT and some network mounts are not, and
# bootstrap fails rather than leaving a directory only one side can write.
CODEBOX_DOCKER_SHARED_DIR=""

# Work on a directory you already have, instead. The path is bind-mounted as-is, keeping
# your ownership — so it is only usable when the box runs under a single uid.
#
#   CODEBOX_DOCKER_MOUNT="~/src/my-project"   ->  /home/coder/my-project in the box
#
# Not compatible with CODEBOX_AGENT_USER: the mount belongs to your uid and the agent runs
# as a separate account, so it could not write. Use CODEBOX_DOCKER_SHARED_DIR for that.
# Setting both this and SHARED_DIR is an error.
CODEBOX_DOCKER_MOUNT=""
# uid the box user is built with. Defaults to yours, which is what makes a mount readable
# and writable from both sides. Only set this if you need a specific one.
CODEBOX_DOCKER_UID=""      # default: your uid (id -u)

# --- several boxes in one file --------------------------------------------
# Everything above is shared by every box. To describe more than one, override individual
# settings with CODEBOX_BOX_<name>_<KEY> and select one with `codebox --box <name>`:
#
#   CODEBOX_BOX_work_LOCAL_PORT=8080
#   CODEBOX_BOX_work_REPO="https://github.com/me/work-project"
#   CODEBOX_BOX_play_LOCAL_PORT=8081
#
# A named box gets the instance name codebox-<name> automatically, and a file-level
# CODEBOX_INSTANCE is not applied to it — two boxes must never share an instance. Set
# CODEBOX_BOX_<name>_INSTANCE to choose your own. Without --box, these entries do nothing.
