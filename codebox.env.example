# codebox configuration — copy to `codebox.env` and edit.
# `codebox.env` is git-ignored; this example file is safe to commit.

# GCP project id (required). If left empty, the active `gcloud config` project is used.
CODEBOX_PROJECT=""

# Compute zone.
CODEBOX_ZONE="us-central1-a"

# Instance name.
CODEBOX_INSTANCE="codebox"

# Machine type: 4 vCPU / 16 GB. Bump for heavier workloads (e.g. e2-standard-8).
CODEBOX_MACHINE_TYPE="e2-standard-4"

# Boot disk size in GB.
CODEBOX_DISK_SIZE="50"

# OS image.
CODEBOX_IMAGE_FAMILY="debian-12"
CODEBOX_IMAGE_PROJECT="debian-cloud"

# Node.js major version to install.
CODEBOX_NODE_VERSION="20"

# Editor ports. LOCAL is on your laptop; REMOTE is what code-server binds to (loopback) on the VM.
CODEBOX_LOCAL_PORT="8080"
CODEBOX_REMOTE_PORT="8080"

# Auto-stop the VM after this many idle minutes. Set to 0 to disable idle shutdown.
CODEBOX_IDLE_TIMEOUT_MIN="30"
