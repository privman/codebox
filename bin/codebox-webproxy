#!/usr/bin/env python3
"""
codebox-webproxy — laptop-side reverse proxy for a dev server running inside a codebox.

A web server on the VM (say port 8000) is reachable through code-server's proxy at
`http://localhost:<CODE_SERVER_PORT>/proxy/<REMOTE_PORT>/`. But pages that emit absolute
(`http://localhost:8000/...`) or root-relative (`/...`) links break there: the browser
resolves them against `localhost:8000` or the code-server root, not the `/proxy/<port>/`
prefix.

This proxy listens on `localhost:<REMOTE_PORT>` and forwards every request to
`http://<CODE_SERVER>/proxy/<REMOTE_PORT>/<same path + query>`. Because the browser now sits
at `localhost:<REMOTE_PORT>`, both absolute-to-localhost:<port> links and root-relative links
resolve back through this proxy and work.

Examples:
    codebox-webproxy                       # :8000 -> http://localhost:8080/proxy/8000/
    codebox-webproxy --password hunter2     # auto-login to code-server first
    codebox-webproxy --listen-port 3000 --remote-port 3000

code-server's /proxy route requires authentication, so pass --password (or
$CODEBOX_PROXY_PASSWORD) to have the proxy log in and reuse the session cookie, or paste an
existing cookie with --cookie. HTTP(S) only — WebSocket upgrades are not proxied.
"""

import argparse
import http.client
import os
import sys
import threading
from http.server import BaseHTTPRequestHandler, ThreadingHTTPServer
from urllib.parse import urlsplit, urlencode

# Headers that must not be forwarded verbatim (per RFC 7230 §6.1) plus a couple we manage.
HOP_BY_HOP = {
    "connection", "keep-alive", "proxy-authenticate", "proxy-authorization",
    "te", "trailer", "trailers", "transfer-encoding", "upgrade",
}
_REDIRECTS = {301, 302, 303, 307, 308}


class Config:
    def __init__(self, args):
        self.listen_host = args.listen_host
        self.listen_port = args.listen_port
        self.remote_port = args.remote_port
        u = urlsplit(args.code_server)
        self.cs_scheme = u.scheme or "http"
        self.cs_host = u.hostname or "localhost"
        self.cs_port = u.port or (443 if self.cs_scheme == "https" else 80)
        self.code_server = f"{self.cs_scheme}://{self.cs_host}:{self.cs_port}"
        self.prefix = f"/proxy/{self.remote_port}"
        self.password = args.password
        self.cookie = args.cookie
        self._lock = threading.Lock()

    def connect(self):
        cls = http.client.HTTPSConnection if self.cs_scheme == "https" else http.client.HTTPConnection
        return cls(self.cs_host, self.cs_port, timeout=30)

    def login(self):
        """POST the password to code-server and capture the session cookie(s). Serialized."""
        if not self.password:
            return False
        with self._lock:
            body = urlencode({"password": self.password})
            conn = self.connect()
            try:
                conn.request("POST", "/login", body=body, headers={
                    "Content-Type": "application/x-www-form-urlencoded",
                    "Content-Length": str(len(body)),
                })
                resp = conn.getresponse()
                resp.read()
                pairs = [c.split(";", 1)[0].strip() for c in (resp.msg.get_all("Set-Cookie") or [])]
                pairs = [p for p in pairs if p]
                if pairs:
                    self.cookie = "; ".join(pairs)
                    return True
                return False
            finally:
                conn.close()


class Handler(BaseHTTPRequestHandler):
    protocol_version = "HTTP/1.1"

    def _send_error(self, code, message):
        payload = message.encode("utf-8")
        self.send_response(code)
        self.send_header("Content-Type", "text/plain; charset=utf-8")
        self.send_header("Content-Length", str(len(payload)))
        self.end_headers()
        self.wfile.write(payload)

    def _make_request(self, cfg, body):
        headers = {}
        for k, v in self.headers.items():
            lk = k.lower()
            if lk in HOP_BY_HOP or lk in ("host", "accept-encoding", "cookie"):
                continue
            headers[k] = v
        if cfg.cookie:
            headers["Cookie"] = cfg.cookie
        conn = cfg.connect()
        conn.request(self.command, cfg.prefix + self.path, body=body, headers=headers)
        return conn, conn.getresponse()

    def _relay(self):
        cfg = self.server.cfg
        length = int(self.headers.get("Content-Length") or 0)
        body = self.rfile.read(length) if length else None

        try:
            conn, resp = self._make_request(cfg, body)
            # code-server bounced us to its login page → (re)authenticate and retry once.
            if resp.status in _REDIRECTS and "/login" in (resp.getheader("Location") or ""):
                resp.read()
                conn.close()
                if not cfg.login():
                    self._send_error(502, "code-server requires authentication. Pass "
                                          "--password (or $CODEBOX_PROXY_PASSWORD), or --cookie.")
                    return
                conn, resp = self._make_request(cfg, body)
                if resp.status in _REDIRECTS and "/login" in (resp.getheader("Location") or ""):
                    resp.read()
                    conn.close()
                    self._send_error(502, "authentication to code-server failed (wrong password?).")
                    return
            data = resp.read()
        except (ConnectionError, OSError) as e:
            self._send_error(502, f"upstream error talking to {cfg.code_server}: {e}")
            return

        self.send_response(resp.status)
        for k, v in resp.msg.items():
            if k.lower() in HOP_BY_HOP or k.lower() == "content-length":
                continue
            self.send_header(k, v)
        self.send_header("Content-Length", str(len(data)))
        self.end_headers()
        if self.command != "HEAD":
            self.wfile.write(data)
        conn.close()

    do_GET = do_POST = do_PUT = do_DELETE = do_PATCH = do_HEAD = do_OPTIONS = _relay

    def log_message(self, fmt, *args):
        sys.stderr.write("codebox-webproxy: " + (fmt % args) + "\n")


def main():
    p = argparse.ArgumentParser(description="Proxy a codebox dev server through code-server's /proxy route.")
    p.add_argument("--listen-host", default="127.0.0.1", help="Address to bind locally (default: 127.0.0.1).")
    p.add_argument("--listen-port", type=int,
                   default=int(os.environ.get("CODEBOX_PROXY_LISTEN_PORT", "8000")),
                   help="Local port to listen on (default: 8000). Usually equal to --remote-port so "
                        "absolute http://localhost:<port>/ links resolve here.")
    p.add_argument("--remote-port", type=int,
                   default=int(os.environ.get("CODEBOX_PROXY_REMOTE_PORT", "8000")),
                   help="The dev-server port inside the VM, used to build /proxy/<port>/ (default: 8000).")
    p.add_argument("--code-server", default=os.environ.get("CODEBOX_PROXY_CODE_SERVER", "http://localhost:8080"),
                   help="Base URL of code-server as reached from this laptop (default: http://localhost:8080).")
    p.add_argument("--password", default=os.environ.get("CODEBOX_PROXY_PASSWORD"),
                   help="code-server password; the proxy logs in and reuses the session cookie.")
    p.add_argument("--cookie", default=os.environ.get("CODEBOX_PROXY_COOKIE"),
                   help="An existing code-server session cookie (e.g. 'code-server-session=...'), "
                        "as an alternative to --password.")
    args = p.parse_args()
    cfg = Config(args)

    if cfg.password and not cfg.cookie:
        print("codebox-webproxy: authenticating to code-server ...", file=sys.stderr)
        if not cfg.login():
            print("codebox-webproxy: warning — initial login failed; will retry on demand.", file=sys.stderr)

    server = ThreadingHTTPServer((cfg.listen_host, cfg.listen_port), Handler)
    server.cfg = cfg
    print(f"codebox-webproxy: http://{cfg.listen_host}:{cfg.listen_port}/  ->  "
          f"{cfg.code_server}{cfg.prefix}/   (Ctrl-C to stop)", file=sys.stderr)
    try:
        server.serve_forever()
    except KeyboardInterrupt:
        print("\ncodebox-webproxy: stopped.", file=sys.stderr)


if __name__ == "__main__":
    main()
